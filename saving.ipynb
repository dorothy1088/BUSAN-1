   "source": [
    "import matplotlib.pyplot as plt\n",
    "months = [1,2,3,4,5,6]\n",
    "sales = [120,135,128,160,175,190]\n",
    "\n",
    "fig, ax= plt.subplots(figsize=(8,6))\n",
    "\n",
    "ax.plot(\n",
    "    months,\n",
    "    sales,\n",
    "    marker='o'\n",
    ")\n",
    "\n",
    "plt.show()\n",
    "# figure\n",
    "\n",
    "fig.savefig('monthly_sales.png')\n"
   ],
